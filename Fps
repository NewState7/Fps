--========================================================--
-- GRAPHICS FUNCTIONS
--========================================================--

local function DisablePostEffects()
	for _, obj in ipairs(Lighting:GetChildren()) do
		if obj:IsA("PostEffect") then
			obj.Enabled = false
		end
	end
end

local function SetStatus(text)
	Status.Text = "● " .. text
end

--========================================================--
-- LOW
--========================================================--

local function SetLow()
	SetStatus("LOW")

	Lighting.GlobalShadows = false
	Lighting.EnvironmentDiffuseScale = 0
	Lighting.EnvironmentSpecularScale = 0

	DisablePostEffects()

	for _, obj in ipairs(Workspace:GetDescendants()) do

		if obj:IsA("ParticleEmitter") then
			obj.Rate = math.min(obj.Rate, 2)

		elseif obj:IsA("Trail") then
			obj.Enabled = false

		elseif obj:IsA("Beam") then
			obj.Enabled = false

		elseif obj:IsA("Smoke")
			or obj:IsA("Fire")
			or obj:IsA("Sparkles") then
			obj.Enabled = false
		end

	end

	BoostFill.Size = UDim2.new(0.95, 0, 1, 0)
end

--========================================================--
-- MEDIUM
--========================================================--

local function SetMedium()
	SetStatus("MEDIUM")

	Lighting.GlobalShadows = false
	Lighting.EnvironmentDiffuseScale = 0.5
	Lighting.EnvironmentSpecularScale = 0.5

	for _, obj in ipairs(Lighting:GetChildren()) do

		if obj:IsA("BloomEffect")
			or obj:IsA("BlurEffect")
			or obj:IsA("DepthOfFieldEffect")
			or obj:IsA("SunRaysEffect") then

			obj.Enabled = false
		end

	end

	for _, obj in ipairs(Workspace:GetDescendants()) do

		if obj:IsA("ParticleEmitter") then
			obj.Rate = math.min(obj.Rate, 10)

		elseif obj:IsA("Trail") then
			obj.Enabled = true

		end

	end

	BoostFill.Size = UDim2.new(0.65, 0, 1, 0)
end

--========================================================--
-- HIGH
--========================================================--

local function SetHigh()
	SetStatus("HIGH")

	Lighting.GlobalShadows = true
	Lighting.EnvironmentDiffuseScale = 1
	Lighting.EnvironmentSpecularScale = 1

	for _, obj in ipairs(Lighting:GetChildren()) do
		if obj:IsA("PostEffect") then
			obj.Enabled = true
		end
	end

	BoostFill.Size = UDim2.new(0.35, 0, 1, 0)
end

--========================================================--
-- FPS BOOST
--========================================================--

local function SetFPSBoost()
	SetStatus("FPS BOOST")

	Lighting.GlobalShadows = false
	Lighting.EnvironmentDiffuseScale = 0
	Lighting.EnvironmentSpecularScale = 0

	DisablePostEffects()

	for _, obj in ipairs(Workspace:GetDescendants()) do

		if obj:IsA("ParticleEmitter") then
			obj.Rate = math.min(obj.Rate, 1)

		elseif obj:IsA("Trail") then
			obj.Enabled = false

		elseif obj:IsA("Beam") then
			obj.Enabled = false

		elseif obj:IsA("Smoke")
			or obj:IsA("Fire")
			or obj:IsA("Sparkles") then
			obj.Enabled = false
		end

	end

	BoostFill.Size = UDim2.new(1, 0, 1, 0)
end

