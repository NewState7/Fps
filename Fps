--========================================================--
-- FPS COUNTER
--========================================================--

local frames = 0
local lastTime = tick()
local currentFPS = 0

RunService.RenderStepped:Connect(function()

	frames += 1

	local now = tick()

	if now - lastTime >= 1 then

		currentFPS = frames
		frames = 0
		lastTime = now

		local ping = 0

		pcall(function()
			ping = math.floor(
				Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
			)
		end)

		Info.Text = "FPS: " .. currentFPS .. "    Ping: " .. ping .. " ms"

		if currentFPS < 30 then
			Info.TextColor3 = Color3.fromRGB(255, 80, 80)

		elseif currentFPS < 60 then
			Info.TextColor3 = Color3.fromRGB(255, 190, 70)

		else
			Info.TextColor3 = Color3.fromRGB(90, 220, 120)
		end

	end
